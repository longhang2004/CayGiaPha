# Base URL of the Spring Boot REST API that the Next.js dev server proxies to.
# The browser always talks to same-origin `/api/*`; this only affects the proxy.
BACKEND_API_URL=http://localhost:8080

# Google OAuth Settings
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin account seed. Local dev falls back to admin@caygiapha.local / Admin@123456
# when these are omitted; production requires explicit values.
# Existing admin accounts are never password-reset on boot unless ADMIN_FORCE_RESET=true.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
# ADMIN_FORCE_RESET=true

# Redis Configuration (Local Docker)
REDIS_URL=redis://localhost:6379

# Upstash Redis Configuration (Production REST API)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Outbound email (collaboration invites, OTP email, feedback).
# EMAIL_ENABLED=true
#
# Preferred on cloud hosts (Railway/Render/Fly often block SMTP ports):
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Cây Gia Phả <onboarding@resend.dev>"   # or your verified domain
#
# Or classic SMTP (works on local / unrestricted networks):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USER=you@gmail.com
# EMAIL_PASS=app_password
# EMAIL_FROM="Cây Gia Phả <you@gmail.com>"
