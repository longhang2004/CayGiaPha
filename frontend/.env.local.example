# Base URL of the Spring Boot REST API that the Next.js dev server proxies to.
# The browser always talks to same-origin `/api/*`; this only affects the proxy.
BACKEND_API_URL=http://localhost:8080

# Google OAuth Settings (used when USE_BACKEND=false)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Redis Configuration (Local Docker)
REDIS_URL=redis://localhost:6379

# Upstash Redis Configuration (Production REST API)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
